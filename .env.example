# Copia este archivo a `.env` y rellena con tus endpoints reales.
# `.env` está en .gitignore y NO se sube al repositorio.
# El script `run.ps1` (Windows) o `run.sh` (Linux/macOS) lo lee y lo
# convierte en `--dart-define=...` al invocar `flutter run`.
#
# Sin `.env` la app compila pero:
#   - las traducciones remotas fallan (URI vacío al hacer POST)
#   - el diccionario cae al asset empaquetado (modo offline)
#   - las animaciones 3D caen al placeholder de texto

LSB_API_URL=https://YOUR_TRANSLATE_API_ID.execute-api.us-east-1.amazonaws.com/translate
LSB_TEXT_API_URL=https://YOUR_TEXT_API_ID.execute-api.us-east-1.amazonaws.com/default/OpenSoul-TextToLSB
LSB_DICTIONARY_API_URL=https://YOUR_DICT_API_ID.execute-api.us-east-1.amazonaws.com/dictionary
LSB_ANIMATIONS_BASE_URL=https://YOUR_ANIMATIONS_BUCKET.s3.us-east-1.amazonaws.com/
LSB_SIGN_IMAGES_BASE_URL=https://YOUR_IMAGES_BUCKET.s3.us-east-1.amazonaws.com/lsb/judicial/
